# MODELE UNIQUEMENT. Ne pas appliquer ni commiter avec ces valeurs.
# Le script scripts/generate-workload-registration.sh genere le vrai fichier
# workload-dev-sealedsecret.yaml chiffre avec le certificat du cluster management.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: workload-dev
  namespace: argocd
  annotations:
    argocd.argoproj.io/sync-wave: "-10"
spec:
  encryptedData:
    name: A_REMPLACER
    server: A_REMPLACER
    config: A_REMPLACER
  template:
    metadata:
      name: workload-dev
      namespace: argocd
      labels:
        argocd.argoproj.io/secret-type: cluster
    type: Opaque
